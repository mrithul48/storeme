{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./apps/frontend/src/*"
      ],
      "@launchcommerce/shared-types": [
        "./packages/shared-types/src"
      ],
      "@launchcommerce/validation": [
        "./packages/validation/src"
      ],
      "@launchcommerce/api-contracts": [
        "./packages/api-contracts/src"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "packages"
  ],
  "extends": "expo/tsconfig.base"
}
