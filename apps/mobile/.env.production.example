# LaunchCommerce Merchant Mobile App - Production Environment Variables
# Used for EAS Build (Production profile) and release bundles

# Production Backend API Gateway Endpoint
EXPO_PUBLIC_API_URL=https://api.launchcommerce.com/api/v1

# Production Web Storefront Domain (used for deep links & sharing store links)
EXPO_PUBLIC_WEB_URL=https://launchcommerce.com

