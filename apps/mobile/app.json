{
  "expo": {
    "name": "LaunchCommerce",
    "slug": "launchcommerce-merchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "launchcommerce",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.launchcommerce.merchant",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "LaunchCommerce requires camera access to capture product photos, barcodes, and store imagery directly in the app.",
        "NSPhotoLibraryUsageDescription": "LaunchCommerce requires access to your photos to upload product photos, store logos, and promotional banners.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.launchcommerce.merchant",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080D28"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#080D28",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#080D28"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload product images and store branding."
        }
      ],
      [
        "expo-secure-store"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
