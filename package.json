{
  "name": "launchcommerce",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@launchcommerce/frontend",
    "dev:all": "node scripts/dev-all.js",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=@launchcommerce/frontend",
    "build:backend": "npm run build --workspace=@launchcommerce/backend",
    "frontend:dev": "npm run dev --workspace=@launchcommerce/frontend",
    "frontend:build": "npm run build --workspace=@launchcommerce/frontend",
    "frontend:start": "npm run start --workspace=@launchcommerce/frontend",
    "backend:dev": "npm run start:dev --workspace=@launchcommerce/backend",
    "backend:build": "npm run build --workspace=@launchcommerce/backend",
    "backend:start": "npm run start:prod --workspace=@launchcommerce/backend",
    "api:dev": "npm run start:dev --workspace=@launchcommerce/backend",
    "api:build": "npm run build --workspace=@launchcommerce/backend",
    "api:start": "npm run start:prod --workspace=@launchcommerce/backend",
    "redis:dev": "node scripts/dev-redis.js",
    "redis:test": "tsx scripts/test-real-redis.ts",
    "mobile:dev": "npm run start --workspace=@launchcommerce/mobile -- -c",
    "mobile:tunnel": "npm run start --workspace=@launchcommerce/mobile -- --tunnel -c",
    "mobile:typecheck": "npm run typecheck --workspace=@launchcommerce/mobile"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
