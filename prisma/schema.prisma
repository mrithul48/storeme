  showAccountIcon    Boolean @default(true)

  // â”€â”€ About section â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  aboutEnabled       Boolean @default(false)
  aboutHeading       String?
  aboutContent       String? @db.Text
  aboutImageUrl      String?
  aboutImagePublicId String?
  vision             String? @db.Text
  mission            String? @db.Text
  badges             Json?   // [{ id, icon, iconPublicId, text, sortOrder }]

  // â”€â”€ Contact section â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
