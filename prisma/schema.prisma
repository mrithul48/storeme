}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MERCHANT PAYMENT CONFIG
// Per-store payment provider credentials (encrypted at rest, never plain-text)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MerchantPaymentConfig {
  id              String  @id @default(cuid())
  storeId         String
  store           Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider        String  @default("razorpay") // "razorpay" â€” extensible to stripe etc.
  keyId           String  // Public key ID â€” not secret, safe to return to client when needed
  encryptedSecret String  @db.Text              // AES-256-GCM encrypted: "iv:authTag:ciphertext"
  isActive        Boolean @default(true)        // false = disconnected (soft delete)
  mode            String  @default("test")      // "test" | "live"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// CUSTOM DOMAIN
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model CustomDomain {
  id                String             @id @default(cuid())
  storeId           String             @unique
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  domain            String             @unique
  status            CustomDomainStatus @default(PENDING_VERIFICATION)
  verificationToken String             @unique
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([domain])
  @@index([storeId])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// MERCHANT CUSTOMER AUTH CONFIG
// Per-store customer authentication configuration (Google OAuth credentials)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model MerchantAuthConfig {
  id                          String   @id @default(cuid())
  storeId                     String   @unique
  store                       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  googleEnabled               Boolean  @default(false)
  googleClientId              String?
  encryptedGoogleClientSecret String?  @db.Text // AES-256-GCM encrypted: "iv:authTag:ciphertext"
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([storeId])
}
