  brandShape          String  @default("SQUARE") // "ROUND" | "SQUARE" | "RECTANGLE"

  // â”€â”€ Category Section â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  categorySectionEnabled Boolean @default(true)
  categoryShape          String  @default("SQUARE") // "ROUND" | "SQUARE" | "RECTANGLE"
  categoryRadius         String  @default("MD")     // "NONE" | "SM" | "MD" | "LG" | "FULL"

